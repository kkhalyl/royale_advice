# Clash Royale API Configuration
ROYALE_API_KEY=your_royale_api_key_here
ROYALE_API_BASE=https://proxy.royaleapi.dev/v1

# Optional: Gemini API key for LLM-powered advice
# GEMINI_API_KEY=your_gemini_api_key_here
# LLM_PRIMARY_MODEL=gemini-3.1-flash-lite
# LLM_FALLBACK_MODEL=

# Optional: Groq API key, used as a fallback when Gemini fails/rate-limits
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# Database (SQLite by default; created automatically at startup)
# DATABASE_URL=sqlite:///./data/royal_advice.db

# Reddit API (used by the ingestion/ pipeline, not the FastAPI app itself)
# REDDIT_CLIENT_ID=your_reddit_app_client_id
# REDDIT_CLIENT_SECRET=your_reddit_app_client_secret
# REDDIT_USER_AGENT=royal-advice/0.1 by u/your_reddit_username

# FastAPI settings
DEBUG=True
VERIFY_SSL=True

# Comma-separated allowed frontend origins when DEBUG=False (ignored while
# DEBUG=True, which allows all origins for local development).
# CORS_ORIGINS=http://localhost:5173
